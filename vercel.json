{
  "buildCommand": "cd web && npm install && npm run build && cp -r dist ../dist",
  "outputDirectory": "dist",
  "installCommand": "echo 'Handled in buildCommand'",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://ubiquitous-funicular-sfqh.onrender.com/api/$1"
    }
  ]
}
