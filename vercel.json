{
  "framework": "vite",
  "buildCommand": "cd web 2>/dev/null || true; npm install && npm run build",
  "outputDirectory": "web/dist",
  "installCommand": "echo 'Handled in buildCommand'",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://ubiquitous-funicular-sfqh.onrender.com/api/$1"
    }
  ]
}
