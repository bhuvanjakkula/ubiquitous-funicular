{
  "name": "borderbooks-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && next build",
    "prisma": "prisma",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run --passWithNoTests --configLoader runner",
    "test:match": "vitest run tests/unit/parsers.test.ts tests/unit/matching.golden.test.ts --configLoader runner",
    "fixture:replay": "tsx scripts/fixture-replay.ts",
    "retention:uploads": "tsx scripts/retention.ts",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "test:watch": "vitest --configLoader runner",
    "smoke": "playwright test",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@clerk/nextjs": "^6.31.6",
    "@prisma/client": "^6.15.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.542.0",
    "next": "^16.3.4",
    "pdfkit": "^0.15.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^18.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/pdfkit": "^0.13.9",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prisma": "^6.15.0",
    "tailwindcss": "^3.4.17",
    "tsx": "4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "onlyBuiltDependencies": ["@clerk/shared", "@prisma/client", "@prisma/engines", "esbuild", "prisma", "sharp"]
  },
  "allowScripts": {
    "esbuild": true,
    "prisma": true,
    "@clerk/shared": true,
    "@prisma/client": true,
    "@prisma/engines": true
  }
}
