{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/v1/:match*",
      "destination": "/api?path=/v1/:match*"
    },
    {
      "source": "/api/:match*",
      "destination": "/api?path=/api/:match*"
    }
  ]
}